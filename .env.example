# Required — used for Static Images keyframes, Tilequery labels, and the map tiles in the browser.
MAPBOX_TOKEN=pk.your_mapbox_token_here

# Optional — enables the gpt-image-1 stylization step. Leave blank to skip (keyframe is used as-is).
OPENAI_API_KEY=

# Optional — enables MiniMax video loops + flyover transitions via fal. Leave blank to skip
# (the frontend cross-fades still images instead).
FAL_KEY=

# fal model endpoint. "minimax/h3-max/image-to-video" supports image_url + end_image_url (first/last frame).
FAL_VIDEO_MODEL=minimax/h3-max/image-to-video
# Resolution must be one of 480P / 768P / 1080P.
FAL_VIDEO_RESOLUTION=768P
# Clip length in seconds. The model accepts a whole number from 5 to 15; values outside that range
# are clamped. Longer clips cost more per generation.
FAL_LOOP_SECONDS=5
FAL_TRANSITION_SECONDS=5

# Mapbox style used for Static Images keyframes. (The Static Images API does not yet support mapbox/standard.)
KEYFRAME_STYLE=mapbox/satellite-streets-v12

# Image size for keyframes (Static Images max is 1280 per side; @2x doubles it).
KEYFRAME_WIDTH=1280
KEYFRAME_HEIGHT=720

# Mapbox style for the 360° orbit frames. Defaults to label-free satellite imagery: the streets
# style bakes road names and POI pins into the raster, which no colour grade can remove.
ORBIT_STYLE=mapbox/satellite-v9

# 360° orbit turntable: number of frames per scene (one per bearing) and the playback rate.
# A full turn takes ORBIT_FRAMES / ORBIT_FPS seconds — 72 / 12 = 6s. Lower ORBIT_FPS to slow it
# down (4 = 18s, 2 = 36s); adjacent frames are cross-faded, so slow speeds stay smooth.
# Fractional values are allowed, down to 0.1.
ORBIT_FRAMES=72
ORBIT_FPS=12

PORT=3000
